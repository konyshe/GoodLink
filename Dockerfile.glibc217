# 仅用于 packet.sh 打包 Linux 二进制。
# CentOS 7 / glibc 2.17，容器内编译，不改动宿主机 glibc。
ARG BASE_IMAGE=docker.m.daocloud.io/library/centos:7
FROM ${BASE_IMAGE}

# CentOS 7 已 EOL，切换到阿里云 vault，避免影响外网官方源可用性
RUN set -eux; \
    sed -i \
        -e 's|^mirrorlist=|#mirrorlist=|g' \
        -e 's|^#baseurl=http://mirror.centos.org/centos/$releasever|baseurl=https://mirrors.aliyun.com/centos-vault/7.9.2009|g' \
        -e 's|^baseurl=http://mirror.centos.org/centos/$releasever|baseurl=https://mirrors.aliyun.com/centos-vault/7.9.2009|g' \
        /etc/yum.repos.d/CentOS-*.repo; \
    yum -y install gcc glibc-devel make git ca-certificates; \
    yum clean all; \
    rm -rf /var/cache/yum

# 由 packet.sh --build-context hostgo=/usr/local/go 注入宿主机工具链
COPY --from=hostgo / /usr/local/go
RUN /usr/local/go/bin/go version

ENV PATH=/usr/local/go/bin:$PATH \
    GOPROXY=https://goproxy.cn,direct \
    GO111MODULE=on \
    GOTOOLCHAIN=local
